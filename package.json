{
  "name": "@wangye/data-platform",
  "version": "0.1.0",
  "private": true,
  "description": "望野数据采集/存储/RAG 引擎",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "data-platform": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "cli": "tsx src/cli/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:smoke": "vitest --run src/__tests__/smoke",
    "test:integration": "vitest --run --no-file-parallelism src/__tests__/integration",
    "test:integration:full": "EMBED_BACKEND=ollama vitest --run --no-file-parallelism src/__tests__/integration",
    "smoke:live": "bash scripts/smoke-live.sh",
    "e2e:loop": "bash scripts/e2e-loop.sh"
  },
  "dependencies": {
    "cron-parser": "^5.5.0",
    "fastify": "^4.28.0",
    "js-yaml": "^4.1.1",
    "node-cron": "^3.0.3",
    "pg": "^8.13.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
