{
  "name": "@wangye/data-platform",
  "version": "0.1.0",
  "private": true,
  "description": "望野数据采集/存储/RAG 引擎",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    }
  },
  "bin": {
    "data-platform": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "cli": "tsx src/cli/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:api": "vitest --run src/__tests__/integration/api",
    "test:integration": "vitest --run --no-file-parallelism src/__tests__/integration/pipeline src/__tests__/integration/parent src/__tests__/integration/embed.test.ts",
    "test:integration:parent": "vitest --run --no-file-parallelism src/__tests__/integration/parent",
    "test:integration:full": "EMBED_BACKEND=ollama vitest --run --no-file-parallelism src/__tests__/integration",
    "test:live": "bash scripts/live-probe.sh",
    "test:smoke": "pnpm test:api",
    "smoke:live": "pnpm test:live",
    "e2e:loop": "bash scripts/e2e-loop.sh"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^8.3.1",
    "cron-parser": "^5.5.0",
    "fastify": "^4.28.0",
    "google-auth-library": "^10.6.2",
    "js-yaml": "^4.1.1",
    "node-cron": "^3.0.3",
    "pg": "^8.13.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
