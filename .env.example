# data-platform 环境变量
# 复制此文件为 .env 并填入实际值

# 数据库连接（必填，独立于父项目数据库）
DATA_PLATFORM_DATABASE_URL=postgresql://user:pass@localhost:5432/data_platform

# Embedding 后端（默认 ollama，无需 API Key）
# ollama — 本地 bge-m3（免费，1024d，中英跨语言最优）
# mock   — 确定性 1024d 向量，仅 I 轨集成测（pnpm test:integration / EMBED_BACKEND=mock）
# voyage — Voyage AI voyage-3-large（学术文本强）
# openai — OpenAI text-embedding-3-small（生态好）
EMBED_BACKEND=ollama
EMBED_API_URL=http://localhost:11434
# EMBED_MODEL=bge-m3           # 可选，覆盖默认模型

# 以下仅 voyage/openai 后端需要：
# EMBED_API_KEY=               # Voyage/OpenAI API Key
# OPENAI_API_KEY=              # 兼容旧版，同 EMBED_API_KEY

# OpenAlex API Key（可选，无 Key 也可访问但速率较低）
OPENALEX_API_KEY=

# CrossRef polite pool email（可选，用于进入 Polite 池获得更稳定服务）
CROSSREF_MAILTO=dev@wangye.app

# Semantic Scholar API Key（推荐；无 Key 速率低且可能 402）
SEMANTIC_SCHOLAR_API_KEY=

# USPTO Open Data Portal API Key（patentsview 源必填；Header X-API-KEY）
# 申请：USPTO 账号 → https://data.uspto.gov/apis/getting-started → MyODP
# API 主机：https://api.uspto.gov（勿用 data.uspto.gov 调 REST，该域仅 Web UI）
# Bulk 全量（免 Key）：https://data.uspto.gov/bulkdata/datasets/pvgpatdis
USPTO_ODP_API_KEY=

# EPO Open Patent Services（epo_ops 源；OAuth Client Credentials）
# 注册：https://developers.epo.org → My Apps → Consumer Key + Secret
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=

# Google Patents BigQuery（google_patents 源）
# Marketplace：https://console.cloud.google.com/marketplace/details/google_patents_public_datasets/google-patents-public-data
# GCP_PROJECT_ID：必填；GOOGLE_APPLICATION_CREDENTIALS：凭证路径
#   - Docker：容器内路径 /gcp/adc.json（宿主机文件挂载见 docker-compose.yml volumes）
#     将凭证副本放入 secrets/gcp-adc.json（600 权限），secrets/ 已加入 .gitignore
#   - 本地开发：留空，gcloud ADC（~/.config/gcloud/application_default_credentials.json）自动发现
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/gcp/adc.json

# SEC EDGAR 必填 User-Agent（公司名 + 邮箱，见 sec.gov 开发者 FAQ）
SEC_EDGAR_USER_AGENT=YourCompany you@example.com

# GitHub PAT（可选；无 Token 60 次/小时）
GITHUB_TOKEN=

# FRED API Key（https://fredaccount.stlouisfed.org）
FRED_API_KEY=

# Yahoo Finance（yahoo_finance 源）：无需 Key；依赖 yahoo-finance2，YAML 默认 enabled: false

# YouTube Data API v3（youtube 源；Query 参数 key=）
# GCP Console 启用 YouTube Data API v3 → 凭据 → API Key
# 配额：默认 10000 units/天；search.list = 100 units/次（见 sources.yml max_search_pages）
YOUTUBE_API_KEY=

# Reddit Data API（reddit 源；OAuth client_credentials）
# 注册：https://www.reddit.com/prefs/apps → 创建 web app → Client ID + Secret
# User-Agent 必填，格式：<platform>:<appId>:<version> (by /u/<reddit_username>)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:wangye-data-platform:0.1 (by /u/your-reddit-user)

# 服务端口（默认 3400）
PORT=3400

# 父仓消费 data-platform 的 base URL（C2；Docker 内常用 http://dp-app:3400）
# DATA_PLATFORM_URL=http://localhost:3400

# arXiv HTML 正文（arxiv_oai 采集入库后同步拉取，见 processors/arxivFulltext.ts）
ARXIV_FULLTEXT_ENABLED=1
# ARXIV_FULLTEXT_MAX_PER_JOB=50
# ARXIV_FULLTEXT_MIN_INTERVAL_MS=3000
# ARXIV_FULLTEXT_MAX_CHARS=200000
# ARXIV_FULLTEXT_TIMEOUT_MS=30000
# DATA_PLATFORM_USER_AGENT=WangyeDataPlatform/0.1 (mailto:dev@wangye.app)

# ── 原始数据本地副本（可选，见 docs/plans/原始数据本地导出与镜像方案.md）──
# D1 默认导出根目录（pnpm cli export）
# DATA_PLATFORM_EXPORT_DIR=./data/export
# D2 采集成功后镜像写盘；未设置则关闭。Docker 建议 ./data/raw 并挂载 volume
# DATA_PLATFORM_RAW_MIRROR=./data/raw
# D2 对已存在 external_id 的 UPDATE 是否覆盖同名文件（默认 0=跳过）
# DATA_PLATFORM_RAW_MIRROR_OVERWRITE=0

# ── 采集日志（可选，见 docs/plans/采集日志与可观测性设计方案.md）──
# L4：采集 NDJSON 落盘（默认 ./data/logs/collect；设为空/off/0 关闭）
# DATA_PLATFORM_COLLECT_LOG_DIR=./data/logs/collect
# L5：每批 dedup 写入 skip_sample 抽样条数（0=关闭；collect --verbose 等价于 5）
# COLLECT_LOG_SKIP_SAMPLES=0
# L6：结构化日志级别（pino）
# LOG_LEVEL=info
