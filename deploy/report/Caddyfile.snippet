# 追加到 /home/ubuntu/work/projects/openhands-assets/Caddyfile
# 依赖已有的 (security_headers_deny) 片段与 openhands-caddy 容器。
report.farview.cn {
    log {
        output file /data/access-report.log {
            roll_size 50MiB
            roll_keep 10
        }
        format json
    }

    import security_headers_deny
    header X-Robots-Tag "noindex, nofollow"
    header Content-Security-Policy "default-src 'none'; style-src 'self'; script-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"

    @html path / /index.html /report.json
    header @html Cache-Control "no-store"
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=3600"

    route {
        reverse_proxy /outpost.goauthentik.io/* http://172.17.0.1:9000

        forward_auth http://172.17.0.1:9000 {
            uri /outpost.goauthentik.io/auth/caddy
            copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name
            trusted_proxies private_ranges
        }

        root * /data/farview-report
        try_files {path} /index.html
        file_server
    }
}
