# report.farview.cn 生成器环境变量（仅服务器；chmod 600；禁止提交真实值）
# 复制为 .env.report 后填写。缺失必需 Key 的源会在报表中显示“缺少凭证”。

# 学术/元数据（可选 Key 可提高限额）
OPENALEX_API_KEY=
NCBI_API_KEY=
CROSSREF_MAILTO=dev@wangye.app

# 经济/统计
FRED_API_KEY=
EIA_API_KEY=
CENSUS_API_KEY=
BEA_API_KEY=

# 材料/视频/代码
MATERIALS_PROJECT_API_KEY=
YOUTUBE_API_KEY=
GITHUB_TOKEN=

# SEC 要求可识别的 User-Agent（不是密码）
SEC_EDGAR_USER_AGENT=WangyeDataPlatform/0.1 (mailto:dev@wangye.app)

# 可选 / 停用源（有则填）
CORE_API_KEY=
USPTO_ODP_API_KEY=
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=
SEMANTIC_SCHOLAR_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
GCP_PROJECT_ID=
